{
  "name": "roberts-garden-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",

    "prebuild:embed": "node copy-embedded-index.js",
    "build:embed": "vite build --config vite.embedded.config.js",
    "prebuild:full": "node copy-full-index.js",
    "build:full": "vite build --config vite.full.config.js",

    "preview:embed": "LOCAL_PREVIEW=true npm run build:embed && npx serve dist/embed -l 3000",
    "preview:full": "LOCAL_PREVIEW=true npm run build:full && npx serve dist/full -l 3001"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}